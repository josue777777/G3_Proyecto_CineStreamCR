@model G3_Proyecto_CineStreamCR.Models.Auth.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Iniciar sesión";
}

<!DOCTYPE html>

<html lang="es">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CineStream CR</title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/auth.css"
          asp-append-version="true" />
</head>

<body>
    <div class="auth-page">

        <div class="auth-background"></div>

        <div class="auth-container">

            <div class="auth-brand">
                <span class="brand-cine">CINE</span>
                <span class="brand-stream">STREAM</span>
                <span class="brand-cr">CR</span>
            </div>

            <div class="auth-card">

                <div class="auth-header">
                    <h1>Iniciar sesión</h1>

                    <p>
                        Disfruta tus películas y continúa donde lo dejaste.
                    </p>
                </div>

                <form asp-controller="Auth"
                      asp-action="Login"
                      method="post"
                      class="auth-form">

                    <div asp-validation-summary="ModelOnly"
                         class="auth-error">
                    </div>

                    <div class="form-group">

                        <label asp-for="Identificador">
                            Correo o nombre de usuario
                        </label>

                        <input asp-for="Identificador"
                               class="auth-input"
                               autocomplete="username"
                               placeholder="Correo o usuario" />

                        <span asp-validation-for="Identificador"
                              class="field-error">
                        </span>

                    </div>

                    <div class="form-group">

                        <label asp-for="Contrasenna">
                            Contraseña
                        </label>

                        <input asp-for="Contrasenna"
                               class="auth-input"
                               autocomplete="current-password"
                               placeholder="Contraseña" />

                        <span asp-validation-for="Contrasenna"
                              class="field-error">
                        </span>

                    </div>

                    <button type="submit"
                            class="auth-button">
                        Iniciar sesión
                    </button>

                </form>

            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>

    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>