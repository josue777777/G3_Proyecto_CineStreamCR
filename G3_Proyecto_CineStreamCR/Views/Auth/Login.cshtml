@model G3_Proyecto_CineStreamCR.Models.Auth.AuthViewModel

@{
    Layout = null;
    ViewData["Title"] = "CineStream CR";
}

<!DOCTYPE html>

<html lang="es">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/auth.css"
          asp-append-version="true" />
</head>

<body>

    <div class="auth-page">

        <div class="auth-background"></div>

        <div class="auth-container">

            <!-- Marca principal -->
            <div class="auth-brand">
                <span class="brand-cine">CINE</span>
                <span class="brand-stream">STREAM</span>
                <span class="brand-cr">CR</span>
            </div>


            <!--
                MostrarRegistro permite regresar directamente
                al formulario de registro cuando este contiene errores.
            -->
            <div id="authCard"
                 class="auth-flip-container @(Model.MostrarRegistro ? "is-register" : "")">


                <!-- ====================================== -->
                <!-- LOGIN -->
                <!-- ====================================== -->

                <section class="auth-card auth-card-login">

                    <div class="auth-header">
                        <h1>Iniciar sesión</h1>

                        <p>
                            Disfruta tus películas y continúa donde lo dejaste.
                        </p>
                    </div>


                    @if (TempData["RegistroExitoso"] != null)
                    {
                        <div class="auth-success">
                            @TempData["RegistroExitoso"]
                        </div>
                    }


                    <form asp-controller="Auth"
                          asp-action="Login"
                          method="post"
                          class="auth-form">

                        <div asp-validation-summary="ModelOnly"
                             class="auth-error">
                        </div>


                        <div class="form-group">

                            <label asp-for="Login.Identificador">
                                Correo o nombre de usuario
                            </label>

                            <input asp-for="Login.Identificador"
                                   class="auth-input"
                                   autocomplete="username"
                                   placeholder="Correo o usuario" />

                            <span asp-validation-for="Login.Identificador"
                                  class="field-error">
                            </span>

                        </div>


                        <div class="form-group">

                            <label asp-for="Login.Contrasenna">
                                Contraseña
                            </label>

                            <input asp-for="Login.Contrasenna"
                                   class="auth-input"
                                   autocomplete="current-password"
                                   placeholder="Contraseña" />

                            <span asp-validation-for="Login.Contrasenna"
                                  class="field-error">
                            </span>

                        </div>


                        <button type="submit"
                                class="auth-button">
                            Iniciar sesión
                        </button>

                    </form>


                    <div class="auth-switch">

                        <span>
                            ¿No tienes una cuenta?
                        </span>

                        <button type="button"
                                id="btnMostrarRegistro"
                                class="auth-switch-button">
                            Crear cuenta
                        </button>

                    </div>

                </section>


                <!-- ====================================== -->
                <!-- REGISTRO -->
                <!-- ====================================== -->

                <section class="auth-card auth-card-register">

                    <div class="auth-header">

                        <h1>Crear cuenta</h1>

                        <p>
                            Crea tu cuenta y comienza a disfrutar CineStream CR.
                        </p>

                    </div>


                    <form asp-controller="Auth"
                          asp-action="Register"
                          method="post"
                          class="auth-form">

                        <div asp-validation-summary="ModelOnly"
                             class="auth-error">
                        </div>


                        <div class="form-group">

                            <label asp-for="Registro.NombreUsuario">
                                Nombre de usuario
                            </label>

                            <input asp-for="Registro.NombreUsuario"
                                   class="auth-input"
                                   autocomplete="username"
                                   placeholder="Nombre de usuario" />

                            <span asp-validation-for="Registro.NombreUsuario"
                                  class="field-error">
                            </span>

                        </div>


                        <div class="form-group">

                            <label asp-for="Registro.Correo">
                                Correo electrónico
                            </label>

                            <input asp-for="Registro.Correo"
                                   class="auth-input"
                                   autocomplete="email"
                                   placeholder="correo@ejemplo.com" />

                            <span asp-validation-for="Registro.Correo"
                                  class="field-error">
                            </span>

                        </div>


                        <div class="form-group">

                            <label asp-for="Registro.Contrasenna">
                                Contraseña
                            </label>

                            <input asp-for="Registro.Contrasenna"
                                   class="auth-input"
                                   autocomplete="new-password"
                                   placeholder="Contraseña" />

                            <span asp-validation-for="Registro.Contrasenna"
                                  class="field-error">
                            </span>

                        </div>


                        <div class="form-group">

                            <label asp-for="Registro.ConfirmarContrasenna">
                                Confirmar contraseña
                            </label>

                            <input asp-for="Registro.ConfirmarContrasenna"
                                   class="auth-input"
                                   autocomplete="new-password"
                                   placeholder="Confirmar contraseña" />

                            <span asp-validation-for="Registro.ConfirmarContrasenna"
                                  class="field-error">
                            </span>

                        </div>


                        <button type="submit"
                                class="auth-button">
                            Crear cuenta
                        </button>

                    </form>


                    <div class="auth-switch">

                        <span>
                            ¿Ya tienes una cuenta?
                        </span>

                        <button type="button"
                                id="btnMostrarLogin"
                                class="auth-switch-button">
                            Iniciar sesión
                        </button>

                    </div>

                </section>

            </div>

        </div>

    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>

    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script src="~/js/auth.js"
            asp-append-version="true">
    </script>

</body>

</html>