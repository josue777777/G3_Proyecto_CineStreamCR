@model G3_Proyecto_CineStreamCR.Models.Auth.AuthViewModel

@{
    Layout = null;
    ViewData["Title"] = "CineStream CR";
}

<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>

    <link rel="stylesheet"
          href="~/css/auth.css"
          asp-append-version="true" />

</head>


<body>


    <!-- =========================================================
         HEADER DE ACCESO
         Parte del proyecto: Login / Registro.
         Finalidad: mantener visible la identidad de CineStream CR
         mientras el usuario navega por la pantalla de acceso.
         ========================================================= -->

    <header class="landing-header">

        <a href="#inicio"
           class="landing-logo">

            <span class="brand-cine">CINE</span>
            <span class="brand-stream">STREAM</span>
            <span class="brand-cr">CR</span>

        </a>


        <nav class="landing-actions">

            <button type="button"
                    id="btnHeaderLogin"
                    class="header-login-button">

                Ingresar

            </button>


            <button type="button"
                    id="btnHeaderRegister"
                    class="header-register-button">

                Crear cuenta

            </button>

        </nav>

    </header>



    <main>


        <!-- =========================================================
             HERO
             Parte del proyecto: presentación visual del acceso.
             Finalidad: ofrecer una entrada cinematográfica inspirada
             en plataformas modernas de streaming.
             ========================================================= -->

        <section id="inicio"
                 class="hero-section">


            <div class="hero-mosaic"
                 aria-hidden="true">

                <div class="mosaic-column mosaic-column-one">
                    <div class="mosaic-card poster-one"></div>
                    <div class="mosaic-card poster-two"></div>
                    <div class="mosaic-card poster-three"></div>
                </div>

                <div class="mosaic-column mosaic-column-two">
                    <div class="mosaic-card poster-four"></div>
                    <div class="mosaic-card poster-five"></div>
                    <div class="mosaic-card poster-six"></div>
                </div>

                <div class="mosaic-column mosaic-column-three">
                    <div class="mosaic-card poster-seven"></div>
                    <div class="mosaic-card poster-eight"></div>
                    <div class="mosaic-card poster-nine"></div>
                </div>

                <div class="mosaic-column mosaic-column-four">
                    <div class="mosaic-card poster-ten"></div>
                    <div class="mosaic-card poster-eleven"></div>
                    <div class="mosaic-card poster-twelve"></div>
                </div>

                <div class="mosaic-column mosaic-column-five">
                    <div class="mosaic-card poster-thirteen"></div>
                    <div class="mosaic-card poster-fourteen"></div>
                    <div class="mosaic-card poster-fifteen"></div>
                </div>

            </div>


            <div class="hero-overlay"></div>


            <div class="hero-content">

                <div class="hero-brand">

                    <span class="brand-cine">CINE</span>
                    <span class="brand-stream">STREAM</span>
                    <span class="brand-cr">CR</span>

                </div>


                <h1>
                    Las historias que quieres ver,
                    <span>en un solo lugar.</span>
                </h1>


                <p>
                    Descubre películas, crea tus listas favoritas
                    y continúa disfrutando desde donde lo dejaste.
                </p>


                <div class="hero-actions">

                    <button type="button"
                            id="btnHeroLogin"
                            class="hero-primary-button">

                        Iniciar sesión

                    </button>


                    <button type="button"
                            id="btnHeroRegister"
                            class="hero-secondary-button">

                        Crear cuenta

                    </button>

                </div>

            </div>


            <a href="#acceso"
               class="scroll-indicator"
               aria-label="Ir al formulario de acceso">

                <span></span>

            </a>

        </section>



        <!-- =========================================================
             AUTENTICACIÓN
             Parte del proyecto: Login y Registro.
             Finalidad: conservar exactamente la funcionalidad MVC
             ya implementada mostrando ambos formularios en una vista.
             ========================================================= -->

        <section id="acceso"
                 class="access-section">

            <div class="access-intro">

                <span class="section-eyebrow">
                    CINESTREAM CR
                </span>

                <h2>
                    Tu próxima película comienza aquí
                </h2>

                <p>
                    Ingresa a tu cuenta o crea una nueva
                    para comenzar a disfrutar la plataforma.
                </p>

            </div>


            <!--
                MostrarRegistro conserva abierto el formulario
                de registro cuando el servidor devuelve errores.
            -->

            <div id="authCard"
                 class="auth-flip-container @(Model.MostrarRegistro ? "is-register" : "")">


                <!-- =================================================
                     LOGIN
                     ================================================= -->

                <section class="auth-card auth-card-login">

                    <div class="auth-header">

                        <span class="auth-label">
                            BIENVENIDO
                        </span>

                        <h2>
                            Iniciar sesión
                        </h2>

                        <p>
                            Continúa disfrutando tus películas
                            y listas personales.
                        </p>

                    </div>


                    @if (TempData["RegistroExitoso"] != null)
                    {
                        <div class="auth-success">
                            @TempData["RegistroExitoso"]
                        </div>
                    }


                    <form asp-controller="Auth"
                          asp-action="Login"
                          method="post"
                          class="auth-form">

                        <div asp-validation-summary="ModelOnly"
                             class="auth-error">
                        </div>


                        <div class="form-group">

                            <label asp-for="Login.Identificador">
                                Correo o nombre de usuario
                            </label>

                            <input asp-for="Login.Identificador"
                                   class="auth-input"
                                   autocomplete="username"
                                   placeholder="Correo o usuario" />

                            <span asp-validation-for="Login.Identificador"
                                  class="field-error">
                            </span>

                        </div>


                        <div class="form-group">

                            <label asp-for="Login.Contrasenna">
                                Contraseña
                            </label>

                            <input asp-for="Login.Contrasenna"
                                   class="auth-input"
                                   autocomplete="current-password"
                                   placeholder="Contraseña" />

                            <span asp-validation-for="Login.Contrasenna"
                                  class="field-error">
                            </span>

                        </div>


                        <button type="submit"
                                class="auth-button">

                            Iniciar sesión

                        </button>

                    </form>


                    <div class="auth-switch">

                        <span>
                            ¿Aún no tienes una cuenta?
                        </span>

                        <button type="button"
                                id="btnMostrarRegistro"
                                class="auth-switch-button">

                            Crear cuenta

                        </button>

                    </div>

                </section>



                <!-- =================================================
                     REGISTRO
                     ================================================= -->

                <section class="auth-card auth-card-register">

                    <div class="auth-header">

                        <span class="auth-label">
                            ÚNETE A CINESTREAM
                        </span>

                        <h2>
                            Crear cuenta
                        </h2>

                        <p>
                            Regístrate para comenzar a organizar
                            y disfrutar tus películas favoritas.
                        </p>

                    </div>


                    <form asp-controller="Auth"
                          asp-action="Register"
                          method="post"
                          class="auth-form">

                        <div asp-validation-summary="ModelOnly"
                             class="auth-error">
                        </div>


                        <div class="form-group">

                            <label asp-for="Registro.NombreUsuario">
                                Nombre de usuario
                            </label>

                            <input asp-for="Registro.NombreUsuario"
                                   class="auth-input"
                                   autocomplete="username"
                                   placeholder="Nombre de usuario" />

                            <span asp-validation-for="Registro.NombreUsuario"
                                  class="field-error">
                            </span>

                        </div>


                        <div class="form-group">

                            <label asp-for="Registro.Correo">
                                Correo electrónico
                            </label>

                            <input asp-for="Registro.Correo"
                                   class="auth-input"
                                   autocomplete="email"
                                   placeholder="correo@ejemplo.com" />

                            <span asp-validation-for="Registro.Correo"
                                  class="field-error">
                            </span>

                        </div>


                        <div class="form-group">

                            <label asp-for="Registro.Contrasenna">
                                Contraseña
                            </label>

                            <input asp-for="Registro.Contrasenna"
                                   class="auth-input"
                                   autocomplete="new-password"
                                   placeholder="Contraseña" />

                            <span asp-validation-for="Registro.Contrasenna"
                                  class="field-error">
                            </span>

                        </div>


                        <div class="form-group">

                            <label asp-for="Registro.ConfirmarContrasenna">
                                Confirmar contraseña
                            </label>

                            <input asp-for="Registro.ConfirmarContrasenna"
                                   class="auth-input"
                                   autocomplete="new-password"
                                   placeholder="Confirmar contraseña" />

                            <span asp-validation-for="Registro.ConfirmarContrasenna"
                                  class="field-error">
                            </span>

                        </div>


                        <button type="submit"
                                class="auth-button">

                            Crear cuenta

                        </button>

                    </form>


                    <div class="auth-switch">

                        <span>
                            ¿Ya tienes una cuenta?
                        </span>

                        <button type="button"
                                id="btnMostrarLogin"
                                class="auth-switch-button">

                            Iniciar sesión

                        </button>

                    </div>

                </section>

            </div>

        </section>



        <!-- =========================================================
             PRESENTACIÓN DE LA PLATAFORMA
             Parte del proyecto: contenido visual de bienvenida.
             Finalidad: acercar la página de acceso a la apariencia
             de una plataforma de streaming sin agregar funciones
             que no existan en el enunciado.
             ========================================================= -->

        <section class="experience-section">

            <div class="section-heading">

                <span class="section-eyebrow">
                    DESCUBRE CINESTREAM CR
                </span>

                <h2>
                    Todo pensado para tus películas
                </h2>

            </div>


            <div class="experience-grid">

                <article class="experience-card">

                    <div class="experience-icon">

                        <svg viewBox="0 0 24 24">
                            <path d="M8 5v14l11-7z"></path>
                        </svg>

                    </div>

                    <h3>
                        Reproduce
                    </h3>

                    <p>
                        Disfruta tus películas y continúa
                        desde donde dejaste la reproducción.
                    </p>

                </article>


                <article class="experience-card">

                    <div class="experience-icon">

                        <svg viewBox="0 0 24 24">
                            <path d="M12 3l2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"></path>
                        </svg>

                    </div>

                    <h3>
                        Organiza
                    </h3>

                    <p>
                        Crea WatchLists personalizadas
                        y guarda tus películas favoritas.
                    </p>

                </article>


                <article class="experience-card">

                    <div class="experience-icon">

                        <svg viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="9"></circle>
                            <path d="M8 12l2.5 2.5L16 9"></path>
                        </svg>

                    </div>

                    <h3>
                        Califica
                    </h3>

                    <p>
                        Puntúa tus películas y comparte
                        tu opinión mediante reseñas.
                    </p>

                </article>

            </div>

        </section>



        <!-- =========================================================
             CATÁLOGO VISUAL
             Parte del proyecto: ambientación del acceso.
             Finalidad: anticipar visualmente el catálogo que tendrá
             la aplicación sin crear navegación falsa.
             ========================================================= -->

        <section class="preview-section">

            <div class="preview-content">

                <span class="section-eyebrow">
                    GRANDES HISTORIAS TE ESPERAN
                </span>

                <h2>
                    Encuentra algo para cada momento
                </h2>


                <div class="preview-categories">

                    <span>Acción</span>
                    <span>Drama</span>
                    <span>Comedia</span>
                    <span>Ciencia ficción</span>
                    <span>Animación</span>

                </div>

            </div>

        </section>


    </main>



    <!-- =========================================================
         FOOTER DE ACCESO
         ========================================================= -->

    <footer class="landing-footer">

        <div class="footer-brand">

            <span class="brand-cine">CINE</span>
            <span class="brand-stream">STREAM</span>
            <span class="brand-cr">CR</span>

        </div>


        <p>
            Plataforma académica de streaming de películas.
        </p>


        <div class="footer-separator"></div>


        <span class="footer-copyright">
            © @DateTime.Now.Year CineStream CR
        </span>

    </footer>



    <!-- =========================================================
         SCRIPTS
         ========================================================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>

    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script src="~/js/auth.js"
            asp-append-version="true">
    </script>


</body>

</html>