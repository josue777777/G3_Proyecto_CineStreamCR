@model IEnumerable<G3_Proyecto_CineStreamCR.DAL.Entidades.Pelicula>
@{
    ViewData["Title"] = "Catálogo de Películas";
}

<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">

<style>
    :root {
        --hbo-purple: #9F53FF;
        --hbo-dark-purple: #5F1BCE;
        --bg-dark: #0A0A16;
        --card-bg: rgba(22, 22, 42, 0.6);
        --border-purple: rgba(159, 83, 255, 0.2);
    }

    body.cinestream-body {
        background-color: var(--bg-dark);
        color: #ffffff;
        font-family: 'Outfit', sans-serif;
    }

    .catalog-header {
        padding: 40px 0 20px 0;
        border-bottom: 1px solid var(--border-purple);
        margin-bottom: 40px;
    }

    .catalog-title {
        font-size: 2.5rem;
        font-weight: 800;
        letter-spacing: 0.5px;
        background: linear-gradient(45deg, #ffffff, var(--hbo-purple));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .catalog-subtitle {
        color: #b0b0d0;
        font-size: 1.1rem;
        margin-top: 5px;
    }

    .movie-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 30px;
        margin-bottom: 60px;
    }

    .movie-card {
        background: var(--card-bg);
        border: 1px solid var(--border-purple);
        border-radius: 16px;
        overflow: hidden;
        backdrop-filter: blur(10px);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        height: 100%;
        position: relative;
    }

    .movie-card:hover {
        transform: translateY(-8px);
        border-color: var(--hbo-purple);
        box-shadow: 0 12px 30px rgba(159, 83, 255, 0.25);
    }

    .movie-poster-wrapper {
        position: relative;
        width: 100%;
        padding-top: 140%; /* Relación de aspecto del póster */
        overflow: hidden;
        background: #000;
    }

    .movie-poster {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s ease;
    }

    .movie-card:hover .movie-poster {
        transform: scale(1.08);
    }

    .movie-card-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(to top, rgba(10, 10, 22, 0.9) 0%, rgba(10, 10, 22, 0.2) 60%, rgba(0, 0, 0, 0) 100%);
        opacity: 0;
        transition: opacity 0.4s ease;
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 2;
    }

    .movie-card:hover .movie-card-overlay {
        opacity: 1;
    }

    .play-btn-circle {
        width: 70px;
        height: 70px;
        background: var(--hbo-purple);
        border: none;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        color: white;
        font-size: 1.8rem;
        box-shadow: 0 0 20px var(--hbo-purple);
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .play-btn-circle:hover {
        background: #ffffff;
        color: var(--hbo-purple);
        box-shadow: 0 0 25px #ffffff;
        transform: scale(1.1);
    }

    .movie-content {
        padding: 24px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .movie-card-title {
        font-size: 1.4rem;
        font-weight: 700;
        margin-bottom: 8px;
        color: white;
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .movie-card-title:hover {
        color: var(--hbo-purple);
    }

    .movie-meta {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 0.85rem;
        color: #9da4c0;
        margin-bottom: 12px;
    }

    .movie-year, .movie-duration {
        background: rgba(255, 255, 255, 0.05);
        padding: 2px 8px;
        border-radius: 4px;
    }

    .movie-rating {
        color: #ffc107;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .movie-synopsis {
        font-size: 0.9rem;
        color: #b0b5d0;
        line-height: 1.5;
        margin-bottom: 20px;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        flex-grow: 1;
    }

    .movie-footer-actions {
        display: flex;
        gap: 12px;
        margin-top: auto;
    }

    .btn-detail {
        flex: 1;
        padding: 10px 16px;
        border: 1px solid var(--border-purple);
        background: rgba(159, 83, 255, 0.05);
        color: white;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        text-align: center;
        transition: all 0.3s ease;
    }

    .btn-detail:hover {
        background: rgba(159, 83, 255, 0.15);
        border-color: var(--hbo-purple);
        color: white;
    }

    .btn-play-card {
        padding: 10px 20px;
        background: var(--hbo-purple);
        border: none;
        color: white;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        text-align: center;
        transition: all 0.3s ease;
    }

    .btn-play-card:hover {
        background: var(--hbo-dark-purple);
        box-shadow: 0 0 15px rgba(159, 83, 255, 0.4);
        color: white;
    }
</style>

<div class="container pb-5">
    <div class="catalog-header">
        <h1 class="catalog-title">Películas</h1>
        <p class="catalog-subtitle">Explora el mejor contenido disponible en CineStream CR.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 rounded" style="background: var(--card-bg); border: 1px dashed var(--border-purple);">
            <p class="text-muted fs-4">No hay películas registradas en este momento.</p>
        </div>
    }
    else
    {
        <div class="movie-grid">
            @foreach (var pelicula in Model)
            {
                <div class="movie-card">
                    <div class="movie-poster-wrapper">
                        <img class="movie-poster" src="@pelicula.PosterUrl" alt="Póster de @pelicula.Titulo" />
                        <div class="movie-card-overlay">
                            <a href="/Reproductor/Ver/@pelicula.IdPelicula" class="play-btn-circle" title="Reproducir película">
                                <span>▶</span>
                            </a>
                        </div>
                    </div>
                    <div class="movie-content">
                        <a href="/Peliculas/Detalle/@pelicula.IdPelicula" class="movie-card-title">@pelicula.Titulo</a>
                        <div class="movie-meta">
                            <span class="movie-year">@pelicula.Anio</span>
                            <span class="movie-duration">@pelicula.DuracionMinutos min</span>
                            <span class="movie-rating">
                                ⭐ @(pelicula.Rating > 0 ? pelicula.Rating.ToString("0.0") : "N/A")
                            </span>
                        </div>
                        <p class="movie-synopsis">@pelicula.Sinopsis</p>
                        <div class="movie-footer-actions">
                            <a href="/Peliculas/Detalle/@pelicula.IdPelicula" class="btn-detail">Detalles</a>
                            <a href="/Reproductor/Ver/@pelicula.IdPelicula" class="btn-play-card">▶ Ver</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
