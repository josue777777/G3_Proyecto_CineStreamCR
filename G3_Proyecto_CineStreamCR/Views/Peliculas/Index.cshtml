@model G3_Proyecto_CineStreamCR.Models.Peliculas.CatalogoIndexViewModel
@{
    ViewData["Title"] = "Catálogo de Películas";
}

<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">

<style>
    :root {
        --hbo-purple: #9F53FF;
        --hbo-dark-purple: #5F1BCE;
        --bg-dark: #0A0A16;
        --card-bg: rgba(22, 22, 42, 0.6);
        --border-purple: rgba(159, 83, 255, 0.2);
    }

    body.cinestream-body {
        background-color: var(--bg-dark);
        color: #ffffff;
        font-family: 'Outfit', sans-serif;
    }

    .catalog-header {
        padding: 40px 0 20px 0;
        border-bottom: 1px solid var(--border-purple);
        margin-bottom: 30px;
    }

    .catalog-title {
        font-size: 2.5rem;
        font-weight: 800;
        letter-spacing: 0.5px;
        background: linear-gradient(45deg, #ffffff, var(--hbo-purple));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .catalog-subtitle {
        color: #b0b0d0;
        font-size: 1.1rem;
        margin-top: 5px;
    }

    /* ==================== FILTROS ==================== */

    .catalog-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        align-items: center;
        margin-bottom: 35px;
        padding: 18px 20px;
        background: var(--card-bg);
        border: 1px solid var(--border-purple);
        border-radius: 16px;
        backdrop-filter: blur(10px);
    }

    .filter-search {
        flex: 1 1 260px;
        position: relative;
    }

    .filter-search input {
        width: 100%;
        padding: 10px 16px;
        border-radius: 8px;
        border: 1px solid var(--border-purple);
        background: rgba(10, 10, 22, 0.8);
        color: white;
        font-size: 0.95rem;
    }

    .filter-search input:focus {
        outline: none;
        border-color: var(--hbo-purple);
        box-shadow: 0 0 10px rgba(159, 83, 255, 0.35);
    }

    .filter-select {
        padding: 10px 14px;
        border-radius: 8px;
        border: 1px solid var(--border-purple);
        background: rgba(10, 10, 22, 0.8);
        color: white;
        font-size: 0.9rem;
        min-width: 150px;
    }

    .filter-select:focus {
        outline: none;
        border-color: var(--hbo-purple);
    }

    /* ==================== GRID ==================== */

    .movie-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 30px;
        margin-bottom: 40px;
    }

    .movie-card {
        background: var(--card-bg);
        border: 1px solid var(--border-purple);
        border-radius: 16px;
        overflow: hidden;
        backdrop-filter: blur(10px);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        height: 100%;
        position: relative;
    }

    .movie-card:hover {
        transform: translateY(-8px);
        border-color: var(--hbo-purple);
        box-shadow: 0 12px 30px rgba(159, 83, 255, 0.25);
    }

    .movie-poster-wrapper {
        position: relative;
        width: 100%;
        padding-top: 140%; /* Relación de aspecto del póster */
        overflow: hidden;
        background: #000;
    }

    .movie-poster {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s ease;
    }

    .movie-card:hover .movie-poster {
        transform: scale(1.08);
    }

    .movie-card-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(to top, rgba(10, 10, 22, 0.9) 0%, rgba(10, 10, 22, 0.2) 60%, rgba(0, 0, 0, 0) 100%);
        opacity: 0;
        transition: opacity 0.4s ease;
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 2;
    }

    .movie-card:hover .movie-card-overlay {
        opacity: 1;
    }

    .play-btn-circle {
        width: 70px;
        height: 70px;
        background: var(--hbo-purple);
        border: none;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        color: white;
        font-size: 1.8rem;
        box-shadow: 0 0 20px var(--hbo-purple);
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .play-btn-circle:hover {
        background: #ffffff;
        color: var(--hbo-purple);
        box-shadow: 0 0 25px #ffffff;
        transform: scale(1.1);
    }

    /* Botón de WatchList sobre el póster */
    .watchlist-toggle-btn {
        position: absolute;
        top: 10px;
        right: 10px;
        z-index: 3;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        border: 1px solid var(--border-purple);
        background: rgba(10, 10, 22, 0.75);
        color: white;
        font-size: 1.1rem;
        font-weight: 700;
        line-height: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        backdrop-filter: blur(6px);
        transition: all 0.25s ease;
    }

    .watchlist-toggle-btn:hover {
        border-color: var(--hbo-purple);
        background: rgba(159, 83, 255, 0.25);
    }

    .watchlist-toggle-btn.is-active {
        background: var(--hbo-purple);
        border-color: var(--hbo-purple);
        box-shadow: 0 0 12px rgba(159, 83, 255, 0.6);
    }

    .movie-content {
        padding: 24px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .movie-card-title {
        font-size: 1.4rem;
        font-weight: 700;
        margin-bottom: 8px;
        color: white;
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .movie-card-title:hover {
        color: var(--hbo-purple);
    }

    .movie-meta {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 0.85rem;
        color: #9da4c0;
        margin-bottom: 12px;
    }

    .movie-year, .movie-duration {
        background: rgba(255, 255, 255, 0.05);
        padding: 2px 8px;
        border-radius: 4px;
    }

    .movie-rating {
        color: #ffc107;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .movie-synopsis {
        font-size: 0.9rem;
        color: #b0b5d0;
        line-height: 1.5;
        margin-bottom: 20px;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        flex-grow: 1;
    }

    .movie-footer-actions {
        display: flex;
        gap: 12px;
        margin-top: auto;
    }

    .btn-detail {
        flex: 1;
        padding: 10px 16px;
        border: 1px solid var(--border-purple);
        background: rgba(159, 83, 255, 0.05);
        color: white;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        text-align: center;
        transition: all 0.3s ease;
    }

    .btn-detail:hover {
        background: rgba(159, 83, 255, 0.15);
        border-color: var(--hbo-purple);
        color: white;
    }

    .btn-lists-card {
        padding: 10px 14px;
        border: 1px solid var(--border-purple);
        background: rgba(159, 83, 255, 0.05);
        color: white;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        text-align: center;
        transition: all 0.3s ease;
    }

    .btn-lists-card:hover {
        background: rgba(159, 83, 255, 0.15);
        border-color: var(--hbo-purple);
        color: white;
    }

    .btn-play-card {
        padding: 10px 20px;
        background: var(--hbo-purple);
        border: none;
        color: white;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        text-align: center;
        transition: all 0.3s ease;
    }

    .btn-play-card:hover {
        background: var(--hbo-dark-purple);
        box-shadow: 0 0 15px rgba(159, 83, 255, 0.4);
        color: white;
    }

    .catalogo-vacio {
        background: var(--card-bg);
        border: 1px dashed var(--border-purple);
    }

    /* ==================== PAGINACIÓN ==================== */

    .catalogo-paginacion {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 20px;
        margin-bottom: 60px;
    }

    .pagina-btn {
        padding: 10px 20px;
        border-radius: 8px;
        border: 1px solid var(--border-purple);
        background: rgba(159, 83, 255, 0.08);
        color: white;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.25s ease;
    }

    .pagina-btn:hover:not(:disabled) {
        background: rgba(159, 83, 255, 0.2);
        border-color: var(--hbo-purple);
    }

    .pagina-btn:disabled {
        opacity: 0.35;
        cursor: not-allowed;
    }

    .pagina-info {
        color: #b0b5d0;
        font-size: 0.9rem;
    }
</style>

<div class="container pb-5">
    <div class="catalog-header">
        <h1 class="catalog-title">Películas</h1>
        <p class="catalog-subtitle">Explora el mejor contenido disponible en CineStream CR.</p>
    </div>

    <div class="catalog-filters">
        <div class="filter-search">
            <input type="text"
                   id="filtro-busqueda"
                   placeholder="Buscar por título..."
                   value="@Model.Filtro.Busqueda"
                   aria-label="Buscar película por título" />
        </div>

        <select id="filtro-genero" class="filter-select" aria-label="Filtrar por género">
            <option value="">Todos los géneros</option>
            @foreach (var genero in Model.Generos)
            {
                <option value="@genero.IdGenero" selected="@(Model.Filtro.IdGenero == genero.IdGenero)">@genero.Nombre</option>
            }
        </select>

        <select id="filtro-anio" class="filter-select" aria-label="Filtrar por año">
            <option value="">Todos los años</option>
            @foreach (var anio in Model.Anios)
            {
                <option value="@anio" selected="@(Model.Filtro.Anio == anio)">@anio</option>
            }
        </select>

        <select id="filtro-orden" class="filter-select" aria-label="Ordenar por">
            <option value="titulo" selected="@(Model.Filtro.OrdenarPor == "titulo")">Ordenar: Título</option>
            <option value="anio" selected="@(Model.Filtro.OrdenarPor == "anio")">Ordenar: Año</option>
            <option value="rating" selected="@(Model.Filtro.OrdenarPor == "rating")">Ordenar: Calificación</option>
        </select>

        <select id="filtro-direccion" class="filter-select" aria-label="Dirección del orden">
            <option value="asc" selected="@(Model.Filtro.Direccion == "asc")">Ascendente</option>
            <option value="desc" selected="@(Model.Filtro.Direccion == "desc")">Descendente</option>
        </select>
    </div>

    <div id="catalogo-grid-container">
        @await Html.PartialAsync("_CatalogoGrid", Model)
    </div>
</div>

<script>
    (function () {
        const contenedor = document.getElementById('catalogo-grid-container');
        const inputBusqueda = document.getElementById('filtro-busqueda');
        const selectGenero = document.getElementById('filtro-genero');
        const selectAnio = document.getElementById('filtro-anio');
        const selectOrden = document.getElementById('filtro-orden');
        const selectDireccion = document.getElementById('filtro-direccion');

        let debounceTimer = null;

        function construirQuery(pagina) {
            const params = new URLSearchParams();
            if (inputBusqueda.value.trim()) params.set('busqueda', inputBusqueda.value.trim());
            if (selectGenero.value) params.set('idGenero', selectGenero.value);
            if (selectAnio.value) params.set('anio', selectAnio.value);
            params.set('ordenarPor', selectOrden.value);
            params.set('direccion', selectDireccion.value);
            params.set('pagina', pagina);
            return params.toString();
        }

        function cargarCatalogo(pagina) {
            fetch('/Peliculas/Buscar?' + construirQuery(pagina))
                .then(response => {
                    if (!response.ok) throw new Error('Error al buscar películas');
                    return response.text();
                })
                .then(html => {
                    contenedor.innerHTML = html;
                })
                .catch(error => {
                    console.error(error);
                    contenedor.innerHTML = '<div class="alert alert-danger">No se pudo cargar el catálogo. Intenta nuevamente.</div>';
                });
        }

        inputBusqueda.addEventListener('input', () => {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => cargarCatalogo(1), 350);
        });

        [selectGenero, selectAnio, selectOrden, selectDireccion].forEach(select => {
            select.addEventListener('change', () => cargarCatalogo(1));
        });

        // Delegación de eventos: la grilla se reemplaza en cada búsqueda AJAX,
        // así que la paginación y el botón de WatchList se enganchan aquí.
        contenedor.addEventListener('click', (evento) => {
            const botonPagina = evento.target.closest('.pagina-btn');
            if (botonPagina && !botonPagina.disabled) {
                const pagina = parseInt(botonPagina.dataset.page, 10);
                if (!isNaN(pagina)) {
                    cargarCatalogo(pagina);
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
                return;
            }

            const botonWatchList = evento.target.closest('.watchlist-toggle-btn');
            if (botonWatchList) {
                evento.preventDefault();
                evento.stopPropagation();
                toggleWatchList(botonWatchList);
            }
        });

        function toggleWatchList(boton) {
            const idPelicula = parseInt(boton.dataset.id, 10);
            if (!idPelicula) return;

            boton.disabled = true;

            fetch('/Peliculas/ToggleWatchList', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ idPelicula: idPelicula })
            })
                .then(response => {
                    if (!response.ok) throw new Error('No se pudo actualizar tu WatchList');
                    return response.json();
                })
                .then(data => {
                    if (data.success) {
                        boton.classList.toggle('is-active', data.enWatchList);
                        boton.textContent = data.enWatchList ? '✓' : '+';
                        boton.title = data.enWatchList ? 'Quitar de mi lista' : 'Agregar a mi lista';
                    }
                })
                .catch(error => console.error(error))
                .finally(() => { boton.disabled = false; });
        }
    })();
</script>
